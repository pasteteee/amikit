{
 "name": "shapes_test",
 "title": "Shaped pieces test toy",
 "colours": {"tan": "#c89a6c", "cream": "#efe2cc", "sage": "#86a06a", "pink": "#f2a3ad", "blue": "#bcd4ea",
             "rust": "#b55839", "melon": "#d97f75", "gold": "#e0b040"},
 "parts": [
  {"id": "body", "rounds": ["mr 6", "inc 6 to 48", "even 6", "dec 6 to 36", "even 2"], "colour": "tan", "end": "open"},
