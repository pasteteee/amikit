  {"id": "kerchief", "motif": {"kind": "triangle", "width": 22}, "colour": "sage"},
  {"id": "wing", "motif": {"kind": "triangle", "width": 7, "ends": "one", "sew": "side"}, "colour": "rust"},
  {"id": "plate", "motif": {"kind": "leaf", "chain": 8, "tall": "tr"}, "colour": "sage"},
  {"id": "cell", "motif": {"kind": "hexagon", "rounds": 3}, "colour": "gold", "colours": [{"rounds": [3, 3], "colour": "rust"}]},
  {"id": "fin", "motif": {"kind": "half_circle", "rows": 4, "edging": {"kind": "shell", "k": 5, "every": 4, "colour": "blue"}}, "colour": "melon"},
  {"id": "heart", "motif": {"kind": "heart"}, "colour": "pink"},
  {"id": "moon", "motif": {"kind": "crescent", "chain": 10}, "colour": "gold"},
  {"id": "flower", "motif": {"kind": "circle", "rounds": 2, "edging": {"kind": "picot", "every": 2}}, "colour": "pink"},
  {"id": "collar", "rounds": ["ring 36", "inc 6 to 48", "shells 5 every 4"], "colour": "blue", "end": "open", "stuff": "none"},
  {"id": "pad", "rounds": ["ring 30", "inc 4 x3"], "split": true, "colour": "sage", "end": "open", "stuff": "none"},
  {"id": "snood", "rounds": ["ring 36", "rib 36 x2"], "colour": "cream", "end": "open", "stuff": "none"}
 ],
 "assembly": [
