  {"part": "cell", "on": "body", "at": {"round": 7, "az": 0}, "applique": true},
  {"part": "fin", "on": "body", "at": {"round": 5, "az": 120}, "attach": "edge", "dir": [0.5, -0.2, -1], "face": [1, 0, 0]},
  {"part": "heart", "on": "body", "at": {"round": 9, "az": 40}, "applique": true},
  {"part": "moon", "on": "head", "at": {"round": 5, "az": 90}, "applique": true},
  {"part": "flower", "on": "head", "at": {"round": 6, "az": -60}, "applique": true},
  {"part": "collar", "on": "body", "at": {"round": 15}, "around": true},
  {"part": "pad", "on": "head", "at": {"round": 12}, "around": true, "fall": true},
  {"part": "snood", "on": "body", "at": {"round": 16}, "around": true, "dir": [0, 1, 0]}
