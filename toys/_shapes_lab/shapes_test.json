  {"part": "head", "on": "body", "at": {"round": "end"}, "attach": "end", "dir": [0, 1, 0], "sink": 5},
  {"part": "mask", "on": "head", "applique": true, "anchor": "eyes", "offset_mm": [0, -4]},
